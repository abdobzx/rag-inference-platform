# Frontend React Environment Variables
# IMPORTANT: Replace all placeholder values with your actual credentials

# API Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_GATEWAY_URL=http://localhost:8000

# Authentication
VITE_JWT_STORAGE_KEY=accessToken

# Feature Flags
VITE_ENABLE_DEBUG_MODE=false
VITE_ENABLE_ANALYTICS=false

# UI Configuration
VITE_APP_TITLE=SothemaAI
VITE_APP_DESCRIPTION=AI Platform for Pharmaceutical Innovation

# External Services
VITE_SUPPORT_EMAIL=support@sothema.ai
VITE_COMPANY_NAME=Sothema

# Development
VITE_DEV_MODE=true