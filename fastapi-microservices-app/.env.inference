# Inference Service Environment Variables
# IMPORTANT: Replace all placeholder values with your actual credentials

# HuggingFace Configuration
HUGGING_FACE_HUB_TOKEN=your-huggingface-token-here

# Model Configuration
MODEL_NAME=distilgpt2
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# GPU Configuration
USE_GPU=true
GPU_DEVICE=0

# API Configuration
MAX_TOKENS=150
TEMPERATURE=0.7
TOP_P=0.9
TOP_K=50

# Logging
LOG_LEVEL=INFO

# Security
API_KEY_VALIDATION_TIMEOUT=5