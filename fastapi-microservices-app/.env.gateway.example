# Gateway Service Environment Variables
# IMPORTANT: Replace all placeholder values with your actual credentials

# Service URLs
AUTH_SERVICE_URL=http://auth_service:8000
INFERENCE_SERVICE_URL=http://inference_service:8001
LOGGING_SERVICE_URL=http://logging_service:8002

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:80,http://localhost,http://frontend_react:80
ALLOW_CREDENTIALS=true
ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
ALLOW_HEADERS=*

# Rate Limiting (if implemented)
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Logging
LOG_LEVEL=INFO

# Security
API_KEY_HEADER=X-API-Key
JWT_HEADER=Authorization